#!/bin/bash
# JankyBorders: borde en la ventana activa. Colores 0xAARRGGBB.
#   active   = púrpura (el del tema Tokyo Night de Kitty)
#   inactive = transparente (sin borde)
options=(
  style=round
  width=5.0
  hidpi=on
  order=above
  active_color=0xffbb9af7
  inactive_color=0x00000000
)
borders "${options[@]}"
