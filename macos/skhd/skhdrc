# skhd — atajos para abrir apps. "alt" = Option (⌥).
# Recargar: skhd --reload          Logs: /tmp/skhd_$USER.err.log
# Ventanas: Rift (~/.config/rift/config.toml). Aquí solo apps, capturas y botones del mouse.
#
# Teclado Latin American: Option+Q escribe "@" → NUNCA usar "alt - q" aquí.

# ===== Aplicaciones =====
# Sin Rift: apps con `open` normal (open-here.sh necesita Rift).
alt - t    : open -na kitty --args --single-instance -d ~   # vía open: Kitty es dueño de sus permisos
alt - b    : open -a "Safari"
alt - e    : open ~
alt - v    : open -a "Visual Studio Code"
alt - c    : open -a "Claude"
alt - j    : open -a "Spotify"
alt - 0x2B : open -a "System Settings"                      # Option + ,



# ===== Ventanas =====
alt - f    : ~/.local/bin/win-grid max                    # ampliar la ventana enfocada sobre las demás / devolverla
ctrl + alt - left  : ~/.local/bin/win-grid focus left     # foco a la ventana de la izquierda (cruza monitores)
ctrl + alt - right : ~/.local/bin/win-grid focus right
ctrl + alt - up    : ~/.local/bin/win-grid focus up
ctrl + alt - down  : ~/.local/bin/win-grid focus down
alt - g    : ~/.local/bin/win-grid                        # repartir en partes iguales (1–4 ventanas del monitor del mouse)

# ===== Sistema =====
alt - l         : /usr/bin/pmset sleepnow                    # dormir el Mac

# ===== Captura =====
alt - s    : ~/.config/skhd/screenshot.sh                   # monitor bajo el mouse → portapapeles
alt + shift - s : ~/.config/skhd/screenshot-area.sh         # área / Espacio = ventana → portapapeles

# ===== Mouse Razer Basilisk V3 Pro (F13–F18 en la memoria del mouse) =====
# Mismo mapeo que en Hyprland (repo dotfiles, README → "Mouse").
f13 : ~/.local/bin/send-key ctrl left                      # rueda ←: escritorio anterior (Ctrl+←)
f14 : ~/.local/bin/send-key ctrl right                     # rueda →: escritorio siguiente (Ctrl+→)
f15 : ~/.local/bin/win-grid max                            # Hypershift + clic izq: ampliar / devolver (como ⌥F)
f16 : ~/.local/bin/send-key cmd w                          # Hypershift + clic der: cerrar ventana (Cmd+W)
f17 : ~/.config/skhd/screenshot-area.sh                                     # lateral adelante: captura de área (como ⌥⇧S)
f18 : open -a "Spotify"                                                      # lateral atrás: música
