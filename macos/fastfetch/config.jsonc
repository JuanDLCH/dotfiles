// fastfetch — info del sistema al abrir Kitty. Imagen: ~/.config/fastfetch/logo.png
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",          // Kitty dibuja la imagen real (PNG)
    "source": "~/.config/fastfetch/logo.png",
    "width": 34,
    "height": 19,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow" }
  },
  "modules": [
    "break",
    "title",
    "separator",
    { "type": "os",       "key": "󰀵 OS", "format": "{name} {codename} {version}" },
    { "type": "host",     "key": "󰌢 Host" },
    { "type": "kernel",   "key": " Kernel" },
    { "type": "uptime",   "key": "󰅐 Uptime" },
    { "type": "packages", "key": "󰏖 Packages" },
    { "type": "shell",    "key": " Shell" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "wm",       "key": " WM" },
    "break",
    { "type": "cpu",      "key": " CPU", "format": "{name} ({cores-physical})" },
    { "type": "gpu",      "key": "󰢮 GPU", "format": "{name} ({core-count})" },
    { "type": "command",  "key": "󰍛 Memory", "text": "~/.config/fastfetch/memory.sh" },   // presión real, no la caché
    { "type": "disk",     "key": "󰋊 Disk", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery",  "key": "󰁹 Battery", "format": "{capacity} {status}" },
    "break",
    "colors"
  ]
}
