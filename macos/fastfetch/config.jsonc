// fastfetch — info del sistema al abrir Kitty. Imagen: ~/.config/fastfetch/logo.png
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",          // Kitty dibuja la imagen real (PNG)
    "source": "~/.config/fastfetch/logo.png",
    "width": 30,
    "height": 22,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow" }
  },
  "modules": [
    "break",
    "title",
    "separator",
    { "type": "os",       "key": "󰀵 OS" },
    { "type": "host",     "key": "󰌢 Host" },
    { "type": "kernel",   "key": " Kernel" },
    { "type": "uptime",   "key": "󰅐 Uptime" },
    { "type": "packages", "key": "󰏖 Packages" },
    { "type": "shell",    "key": " Shell" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "wm",       "key": " WM" },
    "break",
    { "type": "cpu",      "key": " CPU" },
    { "type": "gpu",      "key": "󰢮 GPU" },
    { "type": "memory",   "key": " Memory" },
    { "type": "disk",     "key": "󰋊 Disk" },
    { "type": "battery",  "key": "󰁹 Battery" },
    "break",
    "colors"
  ]
}
