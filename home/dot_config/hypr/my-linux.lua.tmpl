{{- $dev := index .devices .device -}}
-- my-linux-configs: personal keybinds and hardware keys for Lua-config Hyprland (HyDE).
-- Managed by chezmoi: edit home/dot_config/hypr/my-linux.lua.tmpl in the repo, then `chezmoi apply`.
-- Loaded by `require("my-linux")` at the end of ~/.config/hypr/hyprland.lua, so it overrides
-- the distro's binds. To replace a bind, unbind it first (flags must match otherwise).
-- Device: {{ .device }}
local home = os.getenv("HOME")

hl.config({
    input = { kb_layout = "{{ $dev.kb_layout }}" },
})

-- Plain F-keys stay free for apps (F2 rename, F5 refresh...); media keys send XF86 codes.
for _, key in ipairs({ "F10", "F12" }) do hl.unbind(key) end

-- Super+L: lock and suspend. Idle and the lid only lock (see lid-lock / hypridle).
hl.unbind("SUPER + L")
hl.bind("SUPER + L", hl.dsp.exec_cmd("sh -c 'loginctl lock-session; sleep 1.5; systemctl suspend'"),
    { description = "[Session] lock and suspend" })

-- Super+F toggles maximized <-> normal; F11 toggles real fullscreen.
local function toggle_state(target)
    local w = assert(hl.get_active_window(), "No active window")
    local state = (tonumber(w.fullscreen) or 0) == target and 0 or target
    hl.dispatch(hl.dsp.window.fullscreen_state({ internal = state, client = state, window = w }))
end
hl.unbind("SHIFT + F11")
hl.unbind("F11")
hl.unbind("ALT + RETURN")
hl.unbind("SUPER + F")
hl.bind("SUPER + F", function() toggle_state(1) end, { description = "[Window Management] toggle maximize" })
hl.bind("F11", function() toggle_state(2) end, { description = "[Window Management] toggle fullscreen" })
{{- if lookPath "swayosd-client" }}

-- OSD for volume, brightness and Caps Lock (SwayOSD is installed on this machine).
for _, b in ipairs({
    { "XF86AudioMute", "mute-toggle", false },
    { "XF86AudioLowerVolume", "-5", true },
    { "XF86AudioRaiseVolume", "+5", true },
}) do
    hl.unbind(b[1])
    hl.bind(b[1], hl.dsp.exec_cmd("swayosd-client --output-volume " .. b[2]),
        { locked = true, repeating = b[3], description = "[Audio] Volume OSD" })
end
for _, b in ipairs({ { "XF86MonBrightnessUp", "+5" }, { "XF86MonBrightnessDown", "-5" } }) do
    hl.unbind(b[1])
    hl.bind(b[1], hl.dsp.exec_cmd("swayosd-client --brightness " .. b[2] .. " --min-brightness 5"),
        { locked = true, repeating = true, description = "[Brightness] OSD" })
end
hl.bind("Caps_Lock", hl.dsp.exec_cmd("swayosd-client --caps-lock"), {
    release = true, non_consuming = true, ignore_mods = true,
    description = "[Keyboard] Caps Lock OSD",
})
{{- end }}
{{- if $dev.laptop }}

-- Closing the lid locks; it suspends only on battery (background work keeps running on AC).
hl.on("hyprland.start", function()
    hl.exec_cmd(home .. "/.local/libexec/lid-lock")
end)
{{- end }}
{{- if $dev.fn_keys }}

-- {{ $dev.description }}: Fn keys (table in devices/{{ .device }}/README.md).
local hw = home .. "/.local/libexec/hw-keys/hw"
hl.on("hyprland.start", function()
    hl.exec_cmd(hw .. " camera watch --osd")   -- Fn+F6: the EC cuts the camera, OSD on change
end)
-- Fn+F4 arrives as Ctrl+Super+XF86TouchpadToggle.
hl.bind("CTRL + SUPER + XF86TouchpadToggle", hl.dsp.exec_cmd(hw .. " touchpad toggle"), { locked = true, description = "[Touchpad] toggle + OSD" })
hl.bind("XF86TouchpadToggle", hl.dsp.exec_cmd(hw .. " touchpad toggle"), { locked = true, description = "[Touchpad] toggle + OSD" })
-- Fn+F12: rotate the built-in screen 180°.
hl.bind("XF86RotateWindows", hl.dsp.exec_cmd(hw .. " rotate"), { locked = true, description = "[Display] rotate laptop screen 180" })
-- Fn+F11 sends Super+P: projection menu (replaces HyDE's Super+P snip).
hl.unbind("SUPER + P")
hl.bind("SUPER + P", hl.dsp.exec_cmd(hw .. " display"), { description = "[Display] projection menu" })
-- Fn+F7 (MSI Center key) arrives as XF86Launch1: cycle the power profile.
hl.bind("XF86Launch1", hl.dsp.exec_cmd(hw .. " profile"), { locked = true, description = "[Power] cycle power profile + OSD" })
{{- end }}
