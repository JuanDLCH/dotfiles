{{- $dev := index .devices .device -}}
{{- /* Paths here are target paths (relative to $HOME) that this machine skips. */ -}}

{{- if not (has .desktop (list "hyprland-lua" "ryoku")) }}
.config/hypr/juandy.lua
{{- end }}
{{- if ne .desktop "hyprland-conf" }}
.config/hypr/juandy.conf
{{- end }}
{{- if has .desktop (list "none" "ryoku") }}
.config/juandy/hypridle.conf
{{- end }}
{{- if or (ne .desktop "ryoku") (not $dev.laptop) }}
.config/ryoku
.local/libexec/ryoku-lid
{{- end }}
{{- if not $dev.fn_keys }}
.local/libexec/hw-keys
{{- end }}
{{- if or (not $dev.laptop) (eq .desktop "ryoku") }}
.local/libexec/lid-lock
{{- end }}
